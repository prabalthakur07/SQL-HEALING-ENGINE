# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for SQL generation + self-healing refactors
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max self-healing retry attempts before giving up
MAX_HEALING_ATTEMPTS=4

# --- Database ---
# "sqlite" (default, bundled demo DB) or "postgres" (real database)
DB_DRIVER=sqlite

# Only required when DB_DRIVER=postgres. Point this at a role that has
# ONLY SELECT grants - see data/roles-init.sql for how to create one.
DATABASE_URL=postgres://sql_engine_readonly:changeme@localhost:5432/demo

# How long (ms) a single Postgres query may run before being killed
PG_STATEMENT_TIMEOUT_MS=5000

# --- Security / ops ---
# Shared secret required in the X-API-Key header. Leave unset for local dev;
# ALWAYS set this before deploying anywhere reachable from the internet.
APP_API_KEY=

# Max requests per minute per IP
RATE_LIMIT_PER_MINUTE=20
